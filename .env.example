# ──────────────────────────────────────────────────────────────
# Seeker AI — master environment reference
# Copy apps/api/.env.example → apps/api/.env  and
#      apps/web/.env.example → apps/web/.env  then fill values.
# The app boots with ZERO keys (demo mode: offline market data +
# deterministic advisor). Add keys to go live incrementally.
# ──────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────
DATABASE_URL="postgresql://seeker:seeker@localhost:5432/seeker_ai?schema=public"

# ── Auth ────────────────────────────────────────────────────
JWT_ACCESS_SECRET="change-me-64-random-chars"
JWT_REFRESH_SECRET="change-me-too-64-random-chars"
# Optional — enables "Continue with Google" when set
GOOGLE_CLIENT_ID=""

# ── AI provider ─────────────────────────────────────────────
# groq | openai | anthropic | gemini | openai-compatible | mock
# "mock" needs no key. Groq has a generous free tier: https://console.groq.com
AI_PROVIDER="groq"
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
# Any OpenAI-compatible endpoint (OpenRouter, Together, Ollama…)
OPENAI_COMPAT_BASE_URL=""
OPENAI_COMPAT_API_KEY=""
OPENAI_COMPAT_MODEL=""

# ── Market data providers (all optional) ────────────────────
# Chain order: nse → yahoo → alphavantage → twelvedata → finnhub → mock
# yahoo + nse need NO keys. mock works fully offline.
MARKET_PROVIDERS="nse,yahoo,mock"
ALPHAVANTAGE_API_KEY=""
TWELVEDATA_API_KEY=""
FINNHUB_API_KEY=""
POLYGON_API_KEY=""

# ── Server ──────────────────────────────────────────────────
PORT=4000
CORS_ORIGIN="http://localhost:5173"
NODE_ENV="development"

# ── Web (apps/web/.env) ─────────────────────────────────────
VITE_API_URL="http://localhost:4000/api"
VITE_GOOGLE_CLIENT_ID=""
