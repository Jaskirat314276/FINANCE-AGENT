{
  "name": "seeker-ai",
  "private": true,
  "version": "1.0.0",
  "description": "Seeker AI — AI-powered personal investment advisor for Indian markets",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "postinstall": "npm run build -w @seeker/shared",
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @seeker/api",
    "dev:web": "npm run dev -w @seeker/web",
    "build": "npm run build -w @seeker/shared && npm run build -w @seeker/api && npm run build -w @seeker/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:engines": "npm run test:engines -w @seeker/api",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w @seeker/api",
    "db:push": "npm run db:push -w @seeker/api",
    "db:seed": "npm run db:seed -w @seeker/api",
    "start": "npm run start -w @seeker/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
